# Server-side secrets are NOT read from this file in production. They live in
# Firebase Secret Manager and are declared in code with defineSecret().
# Set each one once per project with:
#
#   firebase functions:secrets:set PURPLEAIR_API_KEY
#   firebase functions:secrets:set TOGETHER_API_KEY
#
# For the Local Emulator Suite, copy this file to functions/.secret.local and
# fill in values; the emulator loads defineSecret() values from there.
# Never commit .secret.local or any file containing real values.

# PurpleAir read key (https://develop.purpleair.com). Used by pollPurpleAir.
PURPLEAIR_API_KEY=

# Together AI key used by the BreatheAI chat proxy (llama3Chat).
TOGETHER_API_KEY=

# ---- Alerts (work item 3) ----
# Secrets (firebase functions:secrets:set NAME). All four must exist before
# deploying onPollComplete; set unused ones to a placeholder such as "unused".
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Non-secret parameters. Put these in functions/.env (committed defaults are
# in code) or functions/.env.<projectId>.
ALERT_FROM_EMAIL=alerts@valleycleanair.com
APP_URL=https://mv-pollution-tracking-system.web.app
# SMS costs money per message. Off by default. The frontend flag
# REACT_APP_SMS_ALERTS_ENABLED must match.
SMS_ALERTS_ENABLED=false
# Log alert sends without contacting any provider. Only for testing.
ALERT_DRY_RUN=false
