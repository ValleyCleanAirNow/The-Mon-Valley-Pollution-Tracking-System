# Server-side secrets are NOT read from this file in production. They live in
# Firebase Secret Manager and are declared in code with defineSecret().
# Set each one once per project with:
#
#   firebase functions:secrets:set PURPLEAIR_API_KEY
#   firebase functions:secrets:set TOGETHER_API_KEY
#
# For the Local Emulator Suite, copy this file to functions/.secret.local and
# fill in values; the emulator loads defineSecret() values from there.
# Never commit .secret.local or any file containing real values.

# PurpleAir read key (https://develop.purpleair.com). Used by pollPurpleAir.
PURPLEAIR_API_KEY=

# Together AI key used by the BreatheAI chat proxy (llama3Chat).
TOGETHER_API_KEY=
