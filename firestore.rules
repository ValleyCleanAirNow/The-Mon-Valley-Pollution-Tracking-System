rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Sensor snapshots and reading history are written only by the
    // pollPurpleAir Cloud Function (Admin SDK bypasses rules). Public read.
    match /sensors/{sensorId} {
      allow read: if true;
      allow write: if false;

      match /readings/{readingId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Poller status (last run, counts). Public read, server write only.
    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Legacy symptom reports. Replaced by `reports` in the OSAC work item.
    match /symptomReports/{reportId} {
      allow read, update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
    }

    match /healthAssessments/{assessmentId} {
      allow read, update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // Everything else is denied by default.
  }
}
