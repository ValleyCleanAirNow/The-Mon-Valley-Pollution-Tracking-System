# Copy to frontend/.env and fill in from Firebase console > Project settings >
# Your apps > Web app config. These identify the Firebase project and are safe
# to ship in the browser bundle; access is controlled by Firestore rules.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=mv-pollution-tracking-system.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=mv-pollution-tracking-system
REACT_APP_FIREBASE_STORAGE_BUCKET=mv-pollution-tracking-system.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Base URL of deployed Cloud Functions, used by BreatheAI.
REACT_APP_FUNCTIONS_BASE_URL=https://us-central1-mv-pollution-tracking-system.cloudfunctions.net

# NOTE: There is intentionally no PurpleAir or OpenWeatherMap key here.
# Third-party data is fetched server-side by Cloud Functions; the client only
# reads Firestore. See functions/.env.example for server secrets.
